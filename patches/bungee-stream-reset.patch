+	/**
+	 * @brief Reset the stream to its initial state, ready for a new note/playback position.
+	 * @details Completes the pending grain cycle so the Stretcher's internal call-sequence
+	 * counter returns to 0 (specifyGrain expected next). Without this, calling process()
+	 * again after reset would trigger a "called in wrong order" abort inside specifyGrain.
+	 * Then clears the input ring buffer and all output state.
+	 */
+	void reset()
+	{
+		// Each process() call ends with specifyGrain having been called (expected = 1).
+		// We must complete the cycle (analyseGrain + synthesiseGrain) to bring expected
+		// back to 0 before the next note's specifyGrain call.
+		if (!std::isnan(request.position))
+		{
+			inputBuffer.analyseGrain();
+			inputBuffer.stretcher.synthesiseGrain(outputChunk);
+			outputChunkConsumed = 0;
+		}
+
+		request.position = std::numeric_limits<double>::quiet_NaN();
+		outputChunk = {};
+		outputChunkConsumed = 0;
+		framesNeeded = 0.;
+		inputBuffer.reset();
+	}
